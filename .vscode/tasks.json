{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configurar",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "CMake: compilar",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--parallel"],
      "dependsOn": "CMake: configurar",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    }
  ]
}
